# Application URL (Used for canonical URLs, metadata, and absolute asset references)
APP_URL="https://lifestylemobilityscooters.com.au"

# Zoho CRM Serverless Webhook Endpoint (For direct lead and NDIS quote dispatch)
ZOHO_CRM_WEBHOOK_URL="https://flow.zoho.com/api/v1/webhook/your-webhook-token"

# Optional: Web3Forms Access Key for contact / proforma inquiries fallback
