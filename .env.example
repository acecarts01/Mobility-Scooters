# Optional: Resend API Key (for serverless transactional email confirmation)
RESEND_API_KEY="re_your_api_key_here"

# Server-Side Gemini API Key (accessed only via process.env.GEMINI_API_KEY)
GEMINI_API_KEY="your-gemini-api-key"
